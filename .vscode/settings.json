// Place your settings in this file to overwrite default and user settings.
{
	"files.exclude": {
		"out": false // set this to true to hide the "out" folder with the compiled JS files
	},
	"search.exclude": {
		"out": true // set this to false to include "out" folder in search results
	},
	// Turn off tsc task auto detection since we have the necessary tasks as npm scripts
	"js/ts.tsc.autoDetect": "off",
	"workbench.colorCustomizations": {
		"activityBar.background": "#032F03",
		"titleBar.activeBackground": "#044104",
		"titleBar.activeForeground": "#EFFEEF",
		"titleBar.inactiveBackground": "#032F03",
		"titleBar.inactiveForeground": "#EFFEEF",
		"statusBar.background": "#032F03",
		"statusBar.foreground": "#EFFEEF",
		"statusBar.debuggingBackground": "#032F03",
		"statusBar.debuggingForeground": "#EFFEEF",
		"statusBar.noFolderBackground": "#032F03",
		"statusBar.noFolderForeground": "#EFFEEF"
	}
}
